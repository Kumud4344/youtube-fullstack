# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
APP_TIMEZONE=Asia/Kolkata

# Database
MONGODB_URI=mongodb+srv://admin:<db_password>@db.6lybgiu.mongodb.net/?appName=db

# Auth
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
AUTH_COOKIE_NAME=vidora_session
OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_LENGTH=6

# Development modes (never enable insecure shortcuts in production
EMAIL_MODE=development
SMS_MODE=mock
LOCATION_MODE=mock
TRANSLATION_MODE=mock
PAYMENT_MODE=test
# Use mock when Razorpay keys are empty (local default)
# Set RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET for real test checkout
SUBSCRIPTION_DURATION_DAYS=30
VIDEO_STORAGE_DRIVER=local

# Mock location used when LOCATION_MODE=mock
MOCK_LOCATION_CITY=Bengaluru
MOCK_LOCATION_STATE=Karnataka
MOCK_LOCATION_COUNTRY=India

# Email / SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Vidora <noreply@vidora.local>"

# SMS (production provider keys)
SMS_API_KEY=
SMS_API_URL=

# Payments (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Object storage (future)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=

# Realtime
SOCKET_URL=http://localhost:3001
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
SOCKET_PORT=3001

# External APIs
LOCATION_API_KEY=
TRANSLATION_API_KEY=

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
